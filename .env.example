# Copy this file to ".env" and fill in real values: cp .env.example .env
# The real .env is git-ignored and must never be committed.

# Postgres (used by Keycloak, and later by our app's data tables)
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me
POSTGRES_DB=keycloak

# Keycloak admin console login (http://localhost:8080 -> Administration Console)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
