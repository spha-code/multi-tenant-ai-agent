# Copy this file to ".env" and fill in real values: cp .env.example .env
# The real .env is git-ignored and must never be committed.

# Postgres (used by Keycloak, and later by our app's data tables)
# Superuser login: pgAdmin host = "postgres" (docker network name), NOT localhost
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me
POSTGRES_DB=keycloak

# --- Two separate databases in the same container ---
# 1) Keycloak's own db (realm/users/orgs tables; owned by Keycloak, don't touch)
#    docker: docker exec -it app_postgres psql -U keycloak -d keycloak
#    pgAdmin:  host=postgres  user=keycloak (POSTGRES_USER)  db=keycloak

# 2) Application db (tenants/customers/orders with RLS)
#    docker: docker exec -it app_postgres psql -U app_user -d app_db
#    pgAdmin:  host=postgres  user=APP_DB_USER  db=app_db
APP_DB_NAME=app_db
APP_DB_HOST=postgres
APP_DB_PORT=5432

# Application role for data tables (non-superuser; RLS applies to it)
# NOTE: as app_user you only see rows of the current tenant (SET app.tenant_id)
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-too

# Keycloak admin console login (http://localhost:8080 -> Administration Console)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# OIDC identities used by the FastAPI backend
KEYCLOAK_ISSUER=http://localhost:8080/realms/ai-portal
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/ai-portal/protocol/openid-connect/certs
TOKEN_AUDIENCE=ai-portal-backend

# Frontend (Vite dev server runs in docker-compose; read by the *browser*)
VITE_API_BASE_URL=http://localhost:8000
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/ai-portal
VITE_OIDC_CLIENT_ID=ai-portal-frontend

# Backend CORS: which browser origins may call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
